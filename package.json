{
  "name": "@plotdb/video2frames",
  "version": "0.0.1",
  "description": "extract frames from a video in the browser, with webcodecs / ffmpeg-wasm / video-seek fallback",
  "browser": "dist/index.min.js",
  "main": "dist/index.js",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "./build",
    "release": "npx fedep publish -g"
  },
  "keywords": [
    "video",
    "frames",
    "webcodecs",
    "mp4box",
    "ffmpeg"
  ],
  "author": "zbryikt",
  "license": "MIT",
  "devDependencies": {
    "fedep": "^1.9.0",
    "uglify-js": "^3.17.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plotdb/video2frames.git"
  }
}
